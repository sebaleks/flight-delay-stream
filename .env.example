# Copy to .env and fill in. .env is git-ignored; NEVER commit real values.
# The demo runs entirely locally: no cloud credentials are needed.

# ---- Local Kafka stack (docker compose up) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ---- Local data paths (committed exports; override only if relocated) ----
REPLAY_DATA_DIR=data/replay
LOOKUPS_DIR=data/lookups
WEATHER_DATA_DIR=data/weather
GOLDEN_DIR=data/golden
ARTIFACTS_DIR=ml/artifacts

# ---- MLflow evaluation tracking (optional; a pure side effect that degrades
# to a warning when unavailable; local SQLite metadata, local artifact store) ----
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_EXPERIMENT=flight-delay-stream
# MLFLOW_TRACKING=on            # set to "off" to disable tracking entirely

# ---- Confluent Cloud (one-time screenshot deployment ONLY; reviewers never
# need these; create the org near demo time, credits expire 30 days in) ----
# CONFLUENT_BOOTSTRAP_SERVERS=
# CONFLUENT_API_KEY=
# CONFLUENT_API_SECRET=
# CONFLUENT_SR_URL=
# CONFLUENT_SR_API_KEY=
# CONFLUENT_SR_API_SECRET=

# ---- One-time export scripts ONLY (Seb's machine; dies with the export step;
# see docs/PLAN.md). Reviewers and the streaming runtime never read these. ----
# GCP_PROJECT_ID=
# GCS_BUCKET=
# BQ_GOLD_DATASET=flight_delays_gold
