# ---- Secrets & credentials (NEVER commit) ----
.env
.env.*
!.env.example
# Service-account keys / ADC files — we use ADC, but block keys defensively
*-key.json
*_key.json
service-account*.json
gcp-*.json
credentials/
application_default_credentials.json

# ---- Local data (MSDS 682: the replay week, lookups, golden files, and
# weather exports under data/ ARE tracked — the sanctioned git-data
# exceptions in CLAUDE.md section 5. Raw BTS zips stay out of git.) ----
data/bts/*.zip
.data/
*.feather
*.orc
# NOTE: *.csv is intentionally NOT ignored so dbt seeds in dbt/seeds/ are tracked.
# NOTE: *.parquet is intentionally NOT ignored so the data/ exports are tracked.

# ---- Python / uv virtualenvs ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# ---- dbt ----
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/package-lock.concurrent-update-lock
dbt/.user.yml
logs/

# ---- Dagster ----
dagster_home/
.dagster/
tmp*/
*.tmp

# ---- ML artifacts ----
ml/artifacts/
# MLflow: local metadata backend (mlruns/ file store or mlflow.db SQLite) and the
# local artifact fallback (mlartifacts/) used when no GCS_BUCKET is set. Real
# artifacts go to gs://$GCS_BUCKET/mlflow.
mlruns/
mlflow.db
mlflow.db-*
mlartifacts/
*.pkl
*.joblib
*.model

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp

# uv.lock IS committed — do not ignore it.

# CatBoost writes per-fit training logs here; scratch, not source.
catboost_info/
