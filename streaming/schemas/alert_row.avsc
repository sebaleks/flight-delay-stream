{
  "type": "record",
  "name": "AlertRow",
  "namespace": "flightdelay.v1",
  "doc": "Row schema of alerts.jsonl, the file artifact (docs/schemas.md contract 4). NOT registered at the Schema Registry: alerts.jsonl is not a topic; this file is the reference definition the alert writer and its tests import.",
  "fields": [
    {"name": "flight_date", "type": {"type": "int", "logicalType": "date"}, "knowable_at": "schedule"},
    {"name": "carrier", "type": "string", "knowable_at": "schedule"},
    {"name": "flight_number", "type": "string", "knowable_at": "schedule"},
    {"name": "origin", "type": "string", "knowable_at": "schedule"},
    {"name": "dest", "type": "string", "knowable_at": "schedule"},
    {"name": "crs_dep_time", "type": "string", "knowable_at": "schedule"},
    {"name": "delay_probability", "type": "double", "knowable_at": "pre_departure_stream"},
    {"name": "risk_band", "type": "string", "knowable_at": "pre_departure_stream"},
    {"name": "threshold", "type": "double", "knowable_at": "pre_departure_stream", "doc": "the alerting threshold in force"},
    {"name": "issued_at", "type": "string", "knowable_at": "pre_departure_stream", "doc": "ISO-8601 UTC, equals T (event time)"},
    {"name": "mode", "type": "string", "knowable_at": "schedule", "doc": "replay or live"}
  ]
}
